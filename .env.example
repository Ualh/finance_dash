# Copy to .env (never commit it). Every source is optional: a source with no
# credentials is simply not synced.

# Binance: API key with only "Enable Reading" ticked, restricted to this machine's IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Wise: personal API token (Settings > API tokens, "Read only")
WISE_API_TOKEN=
# Optional: use this profile instead of the personal one
# WISE_PROFILE_ID=
# Only balances sync: Wise no longer signs statement requests for personal accounts (PSD2),
# so WISE_PRIVATE_KEY_PATH is no longer used.

# Interactive Brokers: Flex Web Service token + Activity Flex Query id
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Path to SQLite database (default: ./finance_dash.db)
# FINANCE_DASH_DB_FILE=/path/to/finance_dash.db

# Daily backup (finance-dash-backup.timer)
# FINANCE_DASH_BACKUP_DIR=/home/you/backups/finance_dash
# FINANCE_DASH_BACKUP_KEEP=30

# API base URL for the frontend build (empty = same origin, for single-process prod)
# VITE_API_BASE_URL=http://127.0.0.1:8000
